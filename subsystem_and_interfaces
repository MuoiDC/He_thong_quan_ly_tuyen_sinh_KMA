@startuml
title Hình 5.1: Các hệ thống con và giao diện



' ===================== INTERFACES =====================
interface IAccountService {
  ' UC1
  + validateRegistrationData(name: String, email: String,\n  phone: String, password: String) : ValidationResult
  ' UC2
  + recordFailedLogin(email: String) : Integer
  + getFailedLoginCount(email: String) : Integer
  + temporaryLockUser(email: String, durationMinutes: Integer) : Boolean
  ' UC3
  + verifyPassword(userId: String, password: String) : Boolean
  + updateAvatar(userId: String, fileUrl: String) : Boolean
}

interface IAdmissionService {
  ' UC8
  + getApplicationVersions(id: String) : List<PhienBanHoSo>
  ' UC9
  + getApplicationHistory(id: String) : List<LichSuTrangThai>
  ' UC10
  + getResultPublicationStatus() : PublicationStatus
  + markResultViewed(userId: String) : Boolean
  ' UC11
  + declineEnrollment(userId: String, reason: String) : Boolean
  + getEnrollmentStatus(userId: String) : ThiSinhNhapHoc
}

interface IAdmissionDatabase {
  ' UC8
  + saveApplicationVersion(version: PhienBanHoSo) : Boolean
  + findVersionsByApplication(appId: String) : List<PhienBanHoSo>
  ' UC9
  + saveStatusHistory(history: LichSuTrangThai) : Boolean
  + findStatusHistoryByApplication(appId: String) : List<LichSuTrangThai>
  ' UC10
  + markResultViewed(userId: String) : Boolean
  ' UC11
  + findEnrollmentByUser(userId: String) : ThiSinhNhapHoc
}

interface INotificationService {
  ' UC2
  + sendAccountLockedEmail(email: String, unlockAt: DateTime) : Boolean
  ' UC11
  + sendEnrollmentDeclineEmail(userId: String) : Boolean
}

interface ILogDatabase {
  ' UC2
  + saveLoginLog(log: LogDangNhap) : Boolean
  + getRecentFailedCount(email: String, withinMinutes: Integer) : Integer
  ' UC3
  + saveAuditLog(log: LogThayDoiThongTin) : Boolean
}

interface IAccountService {
  + register(name: String, email: String, phone: String, password: String) : Boolean
  + verifyEmail(token: String) : Boolean
  + resendVerificationEmail(email: String) : Boolean
  + login(email: String, password: String) : Session
  + logout(sessionId: String) : void
  + changePassword(userId: String, oldPwd: String, newPwd: String) : Boolean
  + getUserById(id: String) : TaiKhoan
  + getAllUsers(filter: FilterParams) : List<TaiKhoan>
  + updateUser(id: String, info: UserInfo) : Boolean
  + lockUser(id: String, reason: String) : Boolean
  + unlockUser(id: String) : Boolean
  + deleteUser(id: String) : Boolean
  + assignRole(userId: String, role: VaiTro) : Boolean
  + revokeRole(userId: String, role: VaiTro) : Boolean
}

interface ISessionManager {
  + createSession(userId: String, role: VaiTro) : Session
  + getSession(sessionId: String) : Session
  + invalidateSession(sessionId: String) : void
  + invalidateAllSessions(userId: String) : void
  + refreshSession(sessionId: String) : Session
}

interface IAdmissionService {
  + validateApplicationData(data: ApplicationData) : ValidationResult
  + getPostList(filter: FilterParams) : List<BaiDangTuyenSinh>
  + getPostById(id: String) : BaiDangTuyenSinh
  + searchPosts(keyword: String, filter: FilterParams) : List<BaiDangTuyenSinh>
  + createPost(data: PostData) : BaiDangTuyenSinh
  + updatePost(id: String, data: PostData) : Boolean
  + deletePost(id: String) : Boolean
  + submitApplication(userId: String, data: ApplicationData) : HoSo
  + editApplication(id: String, data: ApplicationData) : Boolean
  + getApplicationById(id: String) : HoSo
  + getApplicationsByUser(userId: String) : List<HoSo>
  + getApplicationStatus(id: String) : TrangThai
  + getPendingApplications(filter: FilterParams) : List<HoSo>
  + reviewApplication(id: String, decision: String, note: String) : Boolean
  + updateApplicationStatusManual(id: String, status: TrangThai, reason: String) : Boolean
  + publishResult(data: PublishData) : Boolean
  + cancelPublish(resultId: String, reason: String) : Boolean
  + getResult(userId: String) : KetQuaXetTuyen
  + confirmEnrollment(userId: String, confirm: Boolean) : Boolean
}

interface IChatbotService {
  + chat(sessionId: String, message: String) : String
  + getKnowledgeList() : List<CoSoTriThuc>
  + validateKnowledgeData(data: KnowledgeData)
  + addKnowledge(data: KnowledgeData) : Boolean
  + updateKnowledge(id: String, data: KnowledgeData) : Boolean
  + deleteKnowledge(id: String) : Boolean
  + syncModel() : Boolean
  + flagKnowledgePendingSync(id: String)
}

interface INotificationService {
  + sendEmail(to: String, subject: String, body: String) : Boolean
  + sendVerificationEmail(email: String, token: String) : Boolean
  + sendApplicationStatusEmail(userId: String, status: String, note: String) : Boolean
  + sendResultEmail(userId: String, result: String) : Boolean
  + broadcastResultEmail(userIds: List<String>) : Boolean
  + sendEnrollmentConfirmEmail(userId: String) : Boolean
  + sendRoleChangeEmail(userId: String, newRole: VaiTro) : Boolean
}

interface IReportService {
  + getAvailableReportTypes() : List<String>
  + generateReport(type: ReportType, params: FilterParams, format: String) : BaoCao
  + scheduleReport(type: ReportType, params: FilterParams, format: String) : String
  + getReportStatus(jobId: String) : String
  + exportToExcel(data: ReportData) : File
  + exportToPDF(data: ReportData) : File
}

interface IAccountDatabase {
  + findByEmail(email: String) : TaiKhoan
  + findById(id: String) : TaiKhoan
  + findAll(filter: FilterParams) : List<TaiKhoan>
  + save(account: TaiKhoan) : Boolean
  + update(id: String, data: TaiKhoan) : Boolean
  + delete(id: String) : Boolean
  + updateRole(id: String, role: VaiTro) : Boolean
  + updateStatus(id: String, status: TrangThai) : Boolean
}

interface IAdmissionDatabase {
  + savePost(post: BaiDangTuyenSinh) : Boolean
  + updatePost(id: String, data: BaiDangTuyenSinh) : Boolean
  + deletePost(id: String) : Boolean
  + findPostById(id: String) : BaiDangTuyenSinh
  + findAllPosts(filter: FilterParams) : List<BaiDangTuyenSinh>
  + saveApplication(app: HoSo) : Boolean
  + updateApplication(id: String, data: HoSo) : Boolean
  + findApplicationById(id: String) : HoSo
  + findApplicationsByUser(userId: String) : List<HoSo>
  + findPendingApplications(filter: FilterParams) : List<HoSo>
  + saveResult(result: KetQuaXetTuyen) : Boolean
  + updateResult(id: String, data: KetQuaXetTuyen) : Boolean
  + findResultByUser(userId: String) : KetQuaXetTuyen
  + saveEnrollment(enrollment: ThiSinhNhapHoc) : Boolean
}

interface IChatbotDatabase {
  + saveKnowledge(data: CoSoTriThuc) : Boolean
  + findKnowledgeById(id: String) : CoSoTriThuc
  + findAllKnowledge() : List<CoSoTriThuc>
  + updateKnowledge(id: String, data: CoSoTriThuc) : Boolean
  + deleteKnowledge(id: String) : Boolean
  + updateKnowledgeStatus(id, status)
  + saveConversationLog(log: LogHoiThoai) : Boolean
  + findLogsBySession(sessionId: String) : List<LogHoiThoai>
}

interface IReportDatabase {
  + saveReport(report: BaoCao) : Boolean
  + findReportById(id: String) : BaoCao
  + findAllReports(filter: FilterParams) : List<BaoCao>
  + deleteExpiredReports(before: DateTime) : void
}

interface ILogDatabase {
  + saveLog(log: LogHoatDong) : Boolean
  + findLogs(filter: FilterParams) : List<LogHoatDong>
  + findLogsByActor(actorId: String) : List<LogHoatDong>
  + findLogsByTarget(targetId: String) : List<LogHoatDong>
}

' ===================== SUBSYSTEMS =====================

package "<<subsystem>>\nAccountSubsystem" as AccountSS {
}

package "<<subsystem>>\nAdmissionSubsystem" as AdmissionSS {
}

package "<<subsystem>>\nChatbotSubsystem" as ChatbotSS {
}

package "<<subsystem>>\nNotificationSubsystem" as NotifSS {
}

package "<<subsystem>>\nReportSubsystem" as ReportSS {
}

package "<<subsystem>>\nDatabaseSubsystem" as DatabaseSS {
}

' ===================== ENTITIES =====================
class LogDangNhap <<entity>> {
  - id: String
  - email: String
  - ipAddress: String
  - success: Boolean
  - failedCount: Integer
  - timestamp: DateTime
}

class LogThayDoiThongTin <<entity>> {
  - id: String
  - userId: String
  - fieldName: String
  - oldValue: String
  - newValue: String
  - changedAt: DateTime
}

class PhienBanHoSo <<entity>> {
  - id: String
  - hoSoId: String
  - versionNumber: Integer
  - snapshotData: String
  - savedAt: DateTime
  - savedBy: String
}

class LichSuTrangThai <<entity>> {
  - id: String
  - hoSoId: String
  - trangThaiCu: TrangThai
  - trangThaiMoi: TrangThai
  - changedBy: String
  - note: String
  - changedAt: DateTime
}

class PublicationStatus <<entity>> {
  - isPublished: Boolean
  - publishedAt: DateTime
  - expectedAt: DateTime
}
class TaiKhoan <<entity>> {
  - id: String
  - email: String
  - passwordHash: String
  - name: String
  - phone: String
  - status: TrangThai
  - createdAt: DateTime
}

class VaiTro <<entity>> {
  - id: String
  - name: String
  - permissions: List<String>
}

class HoSo <<entity>> {
  - id: String
  - maHoSo: String
  - userId: String
  - nganh: String
  - phuongThuc: String
  - status: TrangThai
  - submittedAt: DateTime
  - note: String
}

class TaiLieu <<entity>> {
  - id: String
  - hoSoId: String
  - fileName: String
  - fileType: String
  - fileUrl: String
  - uploadedAt: DateTime
}

class BaiDangTuyenSinh <<entity>> {
  - id: String
  - title: String
  - content: String
  - nganh: String
  - chiTieu: Integer
  - status: String
  - publishedAt: DateTime
}

class KetQuaXetTuyen <<entity>> {
  - id: String
  - hoSoId: String
  - userId: String
  - result: String
  - publishedAt: DateTime
  - isPublished: Boolean
}

class ThiSinhNhapHoc <<entity>> {
  - id: String
  - userId: String
  - hoSoId: String
  - confirmedAt: DateTime
  - status: String
}

class CoSoTriThuc <<entity>> {
  - id: String
  - question: String
  - keywords: String
  - answer: String
  - category: String
  - version: Integer
  - updatedAt: DateTime
}

class LogHoiThoai <<entity>> {
  - id: String
  - sessionId: String
  - userId: String
  - message: String
  - response: String
  - timestamp: DateTime
}

class BaoCao <<entity>> {
  - id: String
  - type: String
  - format: String
  - fileUrl: String
  - createdBy: String
  - createdAt: DateTime
  - expiredAt: DateTime
}

class LogHoatDong <<entity>> {
  - id: String
  - actorId: String
  - action: String
  - targetType: String
  - targetId: String
  - note: String
  - timestamp: DateTime
}

